# ---------------------------------------------------------------------------
# AW1 v3 — copia este archivo a .env y ajusta lo que necesites.
# NUNCA subas el .env real a un repositorio.
# ---------------------------------------------------------------------------

AW1_ENV=development              # development | test | production
AW1_HOST=127.0.0.1
AW1_PORT=8000
AW1_LOG_LEVEL=INFO
AW1_LOG_JSON=false
AW1_DATA_DIR=data                # aqui vive el SQLite (si no usas Postgres)

# --- Base de datos -----------------------------------------------------------
# Vacio: SQLite en AW1_DATA_DIR (ideal para local). Con postgres://... o
# postgresql://... usa Postgres (recomendado en la nube). Railway/Render
# inyectan DATABASE_URL solos al agregar el addon; tambien se acepta esa
# variable sin prefijo como alternativa.
AW1_DATABASE_URL=

# --- Ollama (proveedor local, gratis pero necesita CPU/RAM 24/7) -----------
AW1_OLLAMA_HOST=http://127.0.0.1:11434
AW1_OLLAMA_MODEL=mistral
# Modelo pequeno y rapido solo para las decisiones del comparador. Si lo dejas
# vacio se usa el de arriba (lento: cada decision tarda 40-45s con mistral y
# la busqueda completa se queda sin tiempo). Probado: llama3.2:3b va bien
# -qwen2.5:1.5b es tan chico que a veces dice "no hay precio" con la
# informacion justo delante. Ver "Rendimiento en un MacBook Air" en el README.
AW1_OLLAMA_FAST_MODEL=
AW1_OLLAMA_NUM_CTX=8192
AW1_OLLAMA_JUDGE_TIMEOUT=45
AW1_OLLAMA_CHAT_TIMEOUT=120

# --- Groq (proveedor recomendado en la nube: barato y muy rapido) ----------
# Pon AW1_LLM_PROVIDER=groq y una API key gratis de https://console.groq.com/keys
# para que chat y jueces usen Groq en vez de Ollama local.
AW1_LLM_PROVIDER=ollama           # ollama | groq
AW1_GROQ_API_KEY=
AW1_GROQ_MODEL=llama-3.3-70b-versatile
AW1_GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- GPT (opcional, solo tras confirmacion explicita) ----------------------
AW1_OPENAI_API_KEY=
AW1_OPENAI_MODEL=gpt-4o-mini
# Modelo de imagenes que los agentes de Telegram pueden invocar como
# herramienta cuando la persona pide una imagen (misma clave de arriba).
AW1_OPENAI_IMAGE_MODEL=dall-e-3

# --- Busqueda web (opcional, herramienta "@buscar" del chat) ---------------
# Brave Search API: brave.com/search/api -tiene capa gratuita. Sin esto, la
# herramienta @buscar avisa que falta la clave, no falla en silencio.
AW1_BRAVE_SEARCH_API_KEY=

# --- Navegador -------------------------------------------------------------
AW1_BROWSER_HEADLESS=true        # ponlo en false para VER como navega
AW1_BROWSER_MAX_CONTEXTS=3       # paginas simultaneas; sube si tienes RAM
AW1_BROWSER_NAV_TIMEOUT=20
# Proxy rotativo para cuando el navegador corre en un datacenter (ej. AWS) y
# una tienda bloquea esa IP directo (403 inmediato, sin pasar por el sitio).
# Formato estandar: http://usuario:clave@host:puerto -sirve para cualquier
# proveedor que entregue una URL asi (Bright Data, Oxylabs, Smartproxy, etc.).
# Tiene que ser residencial/ISP: uno de datacenter no arregla el bloqueo,
# sigue viendose como datacenter. Vacio: sin proxy.
AW1_BROWSER_PROXY_URL=

# --- Telegram ----------------------------------------------------------------
# URL publica y estable de esta instancia. Sin esto, crear un perfil de
# Telegram (panel admin) falla explicito -hace falta para registrar la
# webhook de cada bot ante la API de Telegram.
AW1_PUBLIC_BASE_URL=https://app.aw1s.online
# Cada cuanto se revisan (en segundos) todos los seguimientos de precio
# activos de todos los bots. Default 6h.
AW1_PRICE_WATCH_INTERVAL_SECONDS=21600
# Memoria de corto plazo de los bots: cuantas horas hacia atras se manda
# como contexto (default 72h) y tope duro de mensajes ademas del tiempo
# (default 120), para que una charla muy activa no mande un historial
# gigante al modelo.
AW1_TELEGRAM_HISTORY_HOURS=72
AW1_TELEGRAM_HISTORY_MAX_MESSAGES=120
# Limites del sandbox donde corre codigo generado por IA (ver
# core/sandbox.py) -tanto al probarlo como despues, ya aprobado.
AW1_SANDBOX_TIMEOUT_SECONDS=10
AW1_SANDBOX_CPU_SECONDS=5
AW1_SANDBOX_MEMORY_MB=256

# --- Comparador ------------------------------------------------------------
AW1_SEARCH_BUDGET_SECONDS=90     # tope duro de una busqueda completa; con Ollama
                                  # local (no Groq) sube a 150 o mas -queda justo
AW1_STORES_PER_SEARCH=5
AW1_PRODUCTS_PER_STORE=2
AW1_MAX_OFFERS=12
AW1_CACHE_TTL_SECONDS=1800
AW1_FX_RATES_TO_CLP={"CLP":1,"USD":950,"EUR":1030,"UF":39000}

# --- Seguridad -------------------------------------------------------------
# Obligatorio (min. 24 caracteres) si AW1_ENV=production.
AW1_API_TOKEN=
AW1_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173
AW1_RATE_LIMIT_PER_MINUTE=90

# --- Solo para probar la instalacion ---------------------------------------
# Levanta `python scripts/demo_store.py 9100` y descomenta estas dos lineas
# para comprobar el comparador sin depender de tiendas reales.
# AW1_DEMO_STORE_URL=http://127.0.0.1:9100
# AW1_ALLOW_PRIVATE_HOSTS=true
