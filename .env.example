# ---------------------------------------------------------------------------
# AW1 v3 — copia este archivo a .env y ajusta lo que necesites.
# NUNCA subas el .env real a un repositorio.
# ---------------------------------------------------------------------------

AW1_ENV=development              # development | test | production
AW1_HOST=127.0.0.1
AW1_PORT=8000
AW1_LOG_LEVEL=INFO
AW1_LOG_JSON=false
AW1_DATA_DIR=data                # aqui vive el SQLite (si no usas Postgres)

# --- Base de datos -----------------------------------------------------------
# Vacio: SQLite en AW1_DATA_DIR (ideal para local). Con postgres://... o
# postgresql://... usa Postgres (recomendado en la nube). Railway/Render
# inyectan DATABASE_URL solos al agregar el addon; tambien se acepta esa
# variable sin prefijo como alternativa.
AW1_DATABASE_URL=

# --- Ollama (proveedor local, gratis pero necesita CPU/RAM 24/7) -----------
AW1_OLLAMA_HOST=http://127.0.0.1:11434
AW1_OLLAMA_MODEL=mistral
# Modelo pequeno y rapido solo para las decisiones del comparador. Si lo dejas
# vacio se usa el de arriba. Con 8 GB de RAM va muy bien qwen2.5:1.5b.
AW1_OLLAMA_FAST_MODEL=
AW1_OLLAMA_NUM_CTX=8192
AW1_OLLAMA_JUDGE_TIMEOUT=45
AW1_OLLAMA_CHAT_TIMEOUT=120

# --- Groq (proveedor recomendado en la nube: barato y muy rapido) ----------
# Pon AW1_LLM_PROVIDER=groq y una API key gratis de https://console.groq.com/keys
# para que chat y jueces usen Groq en vez de Ollama local.
AW1_LLM_PROVIDER=ollama           # ollama | groq
AW1_GROQ_API_KEY=
AW1_GROQ_MODEL=llama-3.3-70b-versatile
AW1_GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- GPT (opcional, solo tras confirmacion explicita) ----------------------
AW1_OPENAI_API_KEY=
AW1_OPENAI_MODEL=gpt-4o-mini

# --- Navegador -------------------------------------------------------------
AW1_BROWSER_HEADLESS=true        # ponlo en false para VER como navega
AW1_BROWSER_MAX_CONTEXTS=3       # paginas simultaneas; sube si tienes RAM
AW1_BROWSER_NAV_TIMEOUT=20

# --- Comparador ------------------------------------------------------------
AW1_SEARCH_BUDGET_SECONDS=90     # tope duro de una busqueda completa
AW1_STORES_PER_SEARCH=5
AW1_PRODUCTS_PER_STORE=2
AW1_MAX_OFFERS=12
AW1_CACHE_TTL_SECONDS=1800
AW1_FX_RATES_TO_CLP={"CLP":1,"USD":950,"EUR":1030,"UF":39000}

# --- Seguridad -------------------------------------------------------------
# Obligatorio (min. 24 caracteres) si AW1_ENV=production.
AW1_API_TOKEN=
AW1_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173
AW1_RATE_LIMIT_PER_MINUTE=90

# --- Solo para probar la instalacion ---------------------------------------
# Levanta `python scripts/demo_store.py 9100` y descomenta estas dos lineas
# para comprobar el comparador sin depender de tiendas reales.
# AW1_DEMO_STORE_URL=http://127.0.0.1:9100
# AW1_ALLOW_PRIVATE_HOSTS=true
